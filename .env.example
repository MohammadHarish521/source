# Official live APIs. Put real values in `.env` — never commit that file.

# REQUIRED. Free Atlas cluster. Database Access + Network Access 0.0.0.0/0.
# https://cloud.mongodb.com → Build a Database → M0 Free → Drivers → copy URI
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fly?retryWrites=true&w=majority
MONGODB_DB=fly

# REQUIRED for live Male CNS queries (partners, types, ROI innervation).
# Get it: https://neuprint.janelia.org → log in with Google → account menu → Account → copy token.
# Dataset we query: male-cns:v1.0
NEUPRINT_TOKEN=
NEUPRINT_SERVER=https://neuprint.janelia.org
NEUPRINT_DATASET=male-cns:v1.0

# OPTIONAL. FlyWire female-brain Codex live downloads (not Male CNS).
CODEX_API_TOKEN=

# OPTIONAL. FlyWire CAVE / materialize (root-id history, live synapses on FAFB).
CAVE_TOKEN=

# OPTIONAL. Only if you later write annotations to Clio (collaborators).
CLIO_TOKEN=
